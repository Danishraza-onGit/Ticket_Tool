{
  "expo": {
    "name": "Cygnus",
    "slug": "cygnus_ticket_tool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cygnus-app-icon-v7.png",
    "scheme": "cygnustickettoolv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.cygnus-ticket-tool",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.cygnus_ticket_tool"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cygnus-splash-v7.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a6513045-09e7-47ac-9f81-af45e9807d4b"
      }
    },
    "owner": "cygnus-mobile-app",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a6513045-09e7-47ac-9f81-af45e9807d4b"
    }
  }
}
