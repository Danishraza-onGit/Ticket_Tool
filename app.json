{
  "expo": {
    "name": "Cygnus",
    "slug": "cygnus_ticket_tool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cygnus-app-icon-v7.png",
    "scheme": "cygnustickettoolv2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.cygnus-ticket-tool"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.cygnus_ticket_tool"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cygnus-splash-v7.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
